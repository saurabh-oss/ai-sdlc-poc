# Copy to .env and fill in real values. Never commit .env.
# Anthropic API key used by the CrewAI agents and injected into Jenkins.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# Prometheus Pushgateway endpoint used by scripts/metrics_exporter.py
PUSHGATEWAY_URL=http://localhost:9091

# Grafana admin password (compose default is "admin")
GF_SECURITY_ADMIN_PASSWORD=admin
